{
  "name": "monochromium",
  "private": true,
  "version": "1.0.13",
  "description": "A pathbound counter-defense game.",
  "author": "Monochromium",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "node electron/dev.mjs",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && electron-forge make",
    "desktop:release:patch": "npm version patch --no-git-tag-version && npm run desktop:make"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "electron": "^43.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
