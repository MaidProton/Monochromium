{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "monochromium-multiplayer-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MultiplayerRoom"
      }
    ]
  },
  "exports": {
    "MultiplayerRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  }
}
